BOT_TOKEN=
ADMIN_USER_IDS=

# local = no remote AI; xkiro = xKiro first with optional GROQ fallback
AI_PROVIDER=xkiro
AI_FALLBACK_PROVIDER=none
AI_TIMEOUT_SECONDS=80
AI_MAX_INPUT_CHARS=60000
AI_MAX_VISION_PAGES=3

XKIRO_API_KEY=
# Recommended single free text+vision model for this workflow.
XKIRO_TEXT_MODEL=qwen/qwen3.5-plus:free
XKIRO_VISION_MODEL=qwen/qwen3.5-plus:free

# Optional fallback. Both values are required to activate it.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
