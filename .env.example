BOT_TOKEN=
ADMIN_USER_IDS=

# local = no remote AI; xkiro = xKiro first with optional GROQ fallback
AI_PROVIDER=xkiro
AI_FALLBACK_PROVIDER=none
AI_TIMEOUT_SECONDS=80
AI_REASONING_EFFORT=none
GROQ_STT_MODEL=whisper-large-v3-turbo
# Use English recognition for Indian-English voice notes. Set to auto only if
# the voice note is primarily Hindi rather than Hinglish / English.
VOICE_LANGUAGE=en
VOICE_TIMEOUT_SECONDS=45
EXTRACTION_TIMEOUT_SECONDS=300
AI_MAX_INPUT_CHARS=1000000
AI_MAX_VISION_PAGES=24
AI_VISION_BATCH_PAGES=6

XKIRO_API_KEY=
# Recommended single free text+vision model for this workflow.
XKIRO_TEXT_MODEL=qwen/qwen3.5-plus:free
XKIRO_VISION_MODEL=qwen/qwen3.5-plus:free

# Optional fallback. Both values are required to activate it.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=
